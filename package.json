{
  "name": "claude-workflow",
  "productName": "Claude Workflow",
  "version": "1.3.1",
  "private": true,
  "description": "A requirement goes in; a reviewed result comes out.",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "serve": "node app/server.mjs",
    "smoke": "node app/smoke.mjs",
    "dist": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "icon": "node build/make-icon.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "local.claude-workflow.app",
    "productName": "Claude Workflow",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": true,
    "files": [
      "desktop/**/*",
      "app/**/*",
      "bin/**/*",
      "!app/workspace",
      "!app/.tmp",
      "!app/.uploads",
      "!tasks",
      "!dist",
      "!**/*.map",
      "!**/*.bak",
      "!desktop/*-test.cjs",
      "!desktop/*-test.mjs",
      "!desktop/run-ticket.mjs",
      "!desktop/setclip.ps1",
      "!.testrun*",
      "!.orphan-test",
      "!.cancel-test",
      "!.sweep-probe"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "ClaudeWorkflow-${version}-portable.exe",
      "unpackDirName": "ClaudeWorkflow"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ClaudeWorkflow-${version}-setup.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Utility"
    },
    "asarUnpack": [
      "bin/**"
    ]
  }
}
